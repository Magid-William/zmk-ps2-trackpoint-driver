DT_COMPAT_ZMK_INPUT_PS2_MOUSE := zmk,input-mouse-ps2

config ZMK_INPUT_MOUSE_PS2
	bool
	default $(dt_compat_enabled,$(DT_COMPAT_ZMK_INPUT_PS2_MOUSE))
    # depends on (!ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL)
	select ZMK_MOUSE
    select PS2

config ZMK_INPUT_MOUSE_PS2_ENABLE_PS2_RESEND_CALLBACK
	bool "Get notifications from the underluing PS2 protocol driver when the received data is invalid and when a resend is requested from the peripheral. This helps the mouse driver to re-align its command buffer and prevent unexpected clicks and jerky movements. With the ps2-uart driver this option is not really necessary, but is very useful for the ps2-gpio driver where mis-transmissions are frequent."
	default n

if ZMK_INPUT_MOUSE_PS2

config ZMK_INPUT_MOUSE_PS2_NO_HOST_COMMANDS
	bool "Never send any host commands to the PS/2 device"
	default n
	help
	  For PS/2 devices that stream data immediately on power-up and reject
	  all host commands (e.g. certain generic trackpoints). Skips the
	  self-test/reset/identification/config handshake, never requests
	  resends, and never writes the enable/disable-reporting commands.
	  With this mode the trackpoint tuning props and the &mms behavior are
	  no-ops.

config ZMK_INPUT_MOUSE_PS2_POWER_ON_RESET_TIME
    int "The POR shall be timed to occur 600 ms ± 20 % from the time power is applied to the TrackPoint controller."
    default 600
    help
      Refer to IBM TrackPoint System Version 4.0 Engineering Specification - Section 2.1

config ZMK_INPUT_MOUSE_PS2_ENABLE_UROB_COMPAT
    bool "Makes the driver compatible with urob's zmk fork. His fork has commits that change the default zmk function definitions. This option adopts the code to make it compatible with his changes. Only enable it if you are using his fork or it will fail to compile."
	default n

config ZMK_INPUT_MOUSE_PS2_ENABLE_ERROR_MITIGATION
    bool "Tries to mitigate transmission errors. Only useful when using a PS2 driver that is prone to miscommunication like the GPIO bitbanging driver."
	default n

config ZMK_INPUT_MOUSE_PS2_REPORT_INTERVAL_MIN
    int "Minimum report rate. Use to avoid bluetooth queue overflow."
    default 0
    help
      Default minimum report interval in milliseconds.
      Slow down input reporting for hid queue over the air.

config ZMK_INPUT_MOUSE_PS2_SPEED_DIVISOR
	int "Divide all movement reports by this value (remainder accumulates)"
	default 1
	range 1 255
	help
	  Scales the pointer speed down without losing small movements: raw
	  deltas are accumulated and only whole multiples of the divisor are
	  reported, so sub-divisor motion is batched instead of dropped.
	  1 = unchanged.

config ZMK_INPUT_MOUSE_PS2_MOVEMENT_EMA_N
	int "Exponential moving average window for movement deltas"
	default 1
	range 1 32
	help
	  Dampens per-bit decode wobble from glitchy decoders (an errored bit 7
	  flips a delta between +127/-128 on near-identical bytes, which makes
	  the cursor erratic). 1 = off; 8 dampens spikes ~8x while preserving
	  slow motion.

config ZMK_INPUT_MOUSE_PS2_MEDIAN_WINDOW
	int "Median filter window for movement deltas (0, 1 = off, 3, 5)"
	default 1
	range 0 5
	help
	  Kills spike bursts from decode packet-boundary slips (which inject
	  full-scale jumps into real motion, usually in bursts of 2-3 packets).
	  5 = median of the last 5 deltas per axis; 3 = median of the last 3.

config ZMK_INPUT_MOUSE_PS2_SLEW_MAX
	int "Reject isolated deltas larger than this (0 = off)"
	default 0
	range 0 255
	help
	  Slew-rate limiter: a delta above SLEW_MAX is only reported if the
	  previous report also exceeded it, so a sustained fast flick is kept
	  while a lone spike is treated as a decode glitch.

config ZMK_INPUT_MOUSE_PS2_DELTA_MAX
	int "Reject single-packet deltas larger than this, replay last accepted (0 = off)"
	default 0
	range 0 255
	help
	  Exp77: single-packet magnitude jump filter. A spurious packet that
	  slips past the gpio-ps2 decode checks (parity/stop-bit all pass)
	  carries an absurd per-packet delta. If |delta| exceeds this threshold,
	  treat it as a jump and re-emit the last accepted value instead of the
	  spike, so the cursor holds rather than leaps. 0 = off.
	  NOTE: this also clips genuine single fast flicks (unlike SLEW_MAX,
	  which exempts sustained big deltas). Exp77: 100.

config ZMK_INPUT_MOUSE_PS2_TELEMETRY
	bool "Print 1s decode counters (input driver + ps2-gpio backend)"
	default n
	help
	  Prints a one-per-second counter line (bytes, packets, alignment
	  aborts, buffer timeouts and the ps2-gpio decode aborts) to help
	  diagnose transmission problems. Off by default.

config ZMK_INPUT_MOUSE_PS2_POWER_CURVE
	bool "RawAccel-style Power velocity curve in the input driver"
	default n
	help
	  Applies a per-sample velocity curve to the movement deltas before the
	  divisor/report stage: f(v) = start + (rate * v)^exponent with
	  v = |(x,y)| per packet. Enabled per device by setting curve-rate on
	  the zmk,input-mouse-ps2 node (0 keeps the raw stream). Compiles
	  power_curve.c, which calls float pow() at init; NEWLIB libc is known
	  to work with it.

endif # ZMK_INPUT_MOUSE_PS2
